set nocompatible
set laststatus=2
set wildmenu
set title
set confirm
filetype on
filetype plugin on
filetype indent on
syntax on

set number
set shiftwidth=4
set tabstop=4
set expandtab
set scrolloff=10
set history=1000

set ignorecase

inoremap " ""<left>
inoremap ' ''<left>
inoremap ( ()<left>
inoremap [ []<left>
inoremap { {}<left>
