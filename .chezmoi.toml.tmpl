{{- $git_name := "kaldray" -}}
{{- $git_email := "" -}}
{{- $is_work_machine := false -}}
{{- $install_dev_tools := true -}}
{{- $install_fonts := true -}}
{{- $configure_system := true -}}
{{- $install_linux_packages := true -}}
{{- $install_aur_fallback := true -}}
{{- $install_opencode := true -}}
{{- $profile := "personal" -}}

{{- if stdinIsATTY -}}

{{- $git_name = promptString "Git username" $git_name -}}
{{- $git_email = promptString "Git email" $git_email -}}
{{- $is_work_machine = promptBool "Is this a work machine" $is_work_machine -}}
{{- $install_dev_tools = promptBool "Install development tools (mise, node, python)" $install_dev_tools -}}

{{- if eq .chezmoi.os "linux" -}}
{{- $profile = promptChoice "Git profile for this Linux machine" (list "work" "personal") "personal" -}}
{{- $install_linux_packages = promptBool "Install Linux packages (niri, zed, mise, lazygit, ghostty, caffeine-ng)" $install_linux_packages -}}
{{- $install_aur_fallback = promptBool "Use yay fallback when pacman package is missing" $install_aur_fallback -}}
{{- $install_opencode = promptBool "Install opencode CLI" $install_opencode -}}
{{- $install_fonts = promptBool "Install Nerd Fonts" $install_fonts -}}
{{- end -}}

{{- if eq .chezmoi.os "darwin" -}}
{{- $profile = "personal" -}}
{{- $install_fonts = promptBool "Install Nerd Fonts" $install_fonts -}}
{{- $configure_system = promptBool "Configure macOS system preferences" $configure_system -}}
{{- end -}}

{{- if eq $profile "work" -}}
{{- $git_name = "jkalenga" -}}
{{- $git_email = "jkalenga@stillnetwork.com" -}}
{{- else -}}
{{- $git_name = "jklenga" -}}
{{- $git_email = "jordray@protonmail.com" -}}
{{- end -}}

{{- end -}}

{{- if eq $git_email "" -}}
{{- fail "Git email is required. Run chezmoi in interactive mode or set it in data." -}}
{{- end -}}

[data]
    git_name = {{ $git_name | quote }}
    git_email = {{ $git_email | quote }}
    is_work_machine = {{ $is_work_machine }}
    install_dev_tools = {{ $install_dev_tools }}
    install_fonts = {{ $install_fonts }}
    configure_system = {{ $configure_system }}
    install_linux_packages = {{ $install_linux_packages }}
    install_aur_fallback = {{ $install_aur_fallback }}
    install_opencode = {{ $install_opencode }}
    profile = {{ $profile | quote }}
