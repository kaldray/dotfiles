#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") .install_linux_packages }}

set -euo pipefail

# Linux package installation is intentionally split by distribution. GUI
# packages are only attempted on native Linux; WSL skips them by default.
is_wsl=0
if grep -qiE '(microsoft|wsl)' /proc/version 2>/dev/null; then
  is_wsl=1
fi

install_packages() {
  local manager="$1"
  shift
  local -a packages=("$@")

  if [ "${#packages[@]}" -eq 0 ]; then
    return 0
  fi

  case "$manager" in
    pacman)
      sudo pacman -S --needed --noconfirm "${packages[@]}"
      ;;
    dnf)
      sudo dnf install -y "${packages[@]}"
      ;;
    apt)
      if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update
        sudo apt-get install -y "${packages[@]}"
      fi
      ;;
  esac
}

install_optional_packages() {
  local manager="$1"
  shift
  local package
  for package in "$@"; do
    echo "→ optional: $package"
    if ! install_packages "$manager" "$package"; then
      echo "⚠️  Package unavailable on this system: $package"
    fi
  done
}

install_arch() {
  install_packages pacman \
    git curl unzip jq eza bat fzf zoxide ripgrep fd helix
  install_optional_packages pacman \
    niri zed mise lazygit ghostty caffeine-ng waybar fuzzel t3code-bin
}

install_fedora() {
  install_packages dnf \
    git curl unzip jq eza bat fzf zoxide ripgrep fd helix
  install_optional_packages dnf \
    niri zed mise lazygit ghostty caffeine-ng waybar fuzzel
}

install_debian() {
  install_packages apt \
    git curl unzip jq eza bat fzf zoxide ripgrep fd helix \
    fontconfig
  install_optional_packages apt lazygit
}

if command -v pacman >/dev/null 2>&1; then
  echo "🐧 Installing packages with pacman (Arch Linux)..."
  install_arch
elif command -v dnf >/dev/null 2>&1; then
  echo "🐧 Installing packages with dnf (Fedora)..."
  install_fedora
elif command -v apt-get >/dev/null 2>&1; then
  echo "🐧 Installing packages with apt (Debian)..."
  install_debian
else
  echo "❌ Unsupported Linux distribution: install dnf, pacman or apt first."
  exit 1
fi

# mise is not consistently packaged across distributions. Install the
# official client only when the package manager did not provide it.
if ! command -v mise >/dev/null 2>&1; then
  echo "📦 Installing mise from its official installer..."
  curl -fsSL https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
fi

{{- if eq .install_aur_fallback }}

if command -v pacman >/dev/null 2>&1; then
  if ! command -v yay >/dev/null 2>&1; then
    echo "📦 Installing yay for AUR packages..."
    tmpdir="$(mktemp -d)"
    git clone https://aur.archlinux.org/yay.git "$tmpdir/yay"
    (
      cd "$tmpdir/yay"
      makepkg -si --noconfirm
    )
    rm -rf "$tmpdir"
  fi
  yay -S --needed --noconfirm zsh-antidote
fi
{{- end }}

if [ "$is_wsl" -eq 1 ]; then
  echo "🪟 WSL detected: skipping desktop-only packages and services."
else
  echo "🖥️  Native Linux detected: desktop packages requested."
fi

echo "✅ Linux packages installed."

# Install the coding-agent CLIs used by T3 Code.
if ! command -v codex >/dev/null 2>&1; then
  echo "🤖 Installing Codex CLI..."
  curl -fsSL https://chatgpt.com/codex/install.sh | bash
fi
if ! command -v claude >/dev/null 2>&1; then
  echo "🤖 Installing Claude Code CLI..."
  curl -fsSL https://claude.ai/install.sh | bash
fi

{{- end }}
