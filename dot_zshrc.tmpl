export XDG_CONFIG_HOME="$HOME/.config"
source "$XDG_CONFIG_HOME/env/common.zsh"
{{- if eq .chezmoi.os "darwin" }}
source "$XDG_CONFIG_HOME/env/darwin.zsh"
{{- else if eq .chezmoi.os "linux" }}
source "$XDG_CONFIG_HOME/env/linux.zsh"
{{- end }}

# export PATH="/opt/homebrew/sbin:$PATH"
# export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
# [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# aliases
alias p="pnpm"
alias ls="ls --color"
alias lg='lazygit'
# alias sail='sh $([ -f sail ] && echo sail || echo vendor/bin/sail)'

precmd() {
  vcs_info
}


{{- if eq .chezmoi.os "darwin" }}
source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
{{- else }}
if [ -f /usr/share/zsh-antidote/antidote.zsh ]; then
  source /usr/share/zsh-antidote/antidote.zsh
elif [ -f /usr/share/antidote/antidote.zsh ]; then
  source /usr/share/antidote/antidote.zsh
fi
{{- end }}

#KEYBINDING
bindkey '^[[A' up-line-or-search
bindkey '^[[B' history-search-forward

#HISTORY
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

#PROMPT
zstyle ':vcs_info:git:*' formats '%b '
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
setopt PROMPT_SUBST
PROMPT='%F{yellow}%*%f %F{blue}%~%f %F{red}${vcs_info_msg_0_}%f$ '

autoload -U add-zsh-hook
autoload -Uz vcs_info

# Set up fzf key bindings and fuzzy completion
eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"
eval "$(mise activate zsh)"
# source <(fzf --zsh)


DRACULA_DISPLAY_TIME=1
DRACULA_TIME_FORMAT="%H:%M"
DRACULA_DISPLAY_FULL_CWD=1
DRACULA_DISPLAY_CONTEXT=1

if command -v antidote >/dev/null 2>&1; then
  antidote load
fi
