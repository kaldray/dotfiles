{{- if eq .chezmoi.os "windows" }}
#Requires -RunAsAdministrator

# Configuration Chezmoi - Installation Windows avec Chocolatey
# Ce script s'exécute UNE FOIS avant l'application des dotfiles

Write-Host "🍫 Setting up Windows environment..." -ForegroundColor Cyan
Write-Host ""

# ============================================
# INSTALLER CHOCOLATEY
# ============================================

if (!(Get-Command choco -ErrorAction SilentlyContinue)) {
    Write-Host "📦 Chocolatey not found. Installing..." -ForegroundColor Yellow
    
    Set-ExecutionPolicy Bypass -Scope Process -Force
    [System.Net.ServicePointManager]::SecurityProtocol = `
        [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
    
    $chocoInstallScript = (New-Object System.Net.WebClient).DownloadString(
        'https://community.chocolatey.org/install.ps1'
    )
    Invoke-Expression $chocoInstallScript
    
    # Refresh environment variables
    $env:Path = [System.Environment]::GetEnvironmentVariable("Path","Machine") + ";" + `
                [System.Environment]::GetEnvironmentVariable("Path","User")
    
    Write-Host "✅ Chocolatey installed successfully!" -ForegroundColor Green
} else {
    $chocoVersion = choco --version
    Write-Host "✅ Chocolatey already installed: v$chocoVersion" -ForegroundColor Green
}

Write-Host ""

# ============================================
# INSTALLER PACKAGES ESSENTIELS
# ============================================

Write-Host "📦 Installing essential packages..." -ForegroundColor Cyan
Write-Host ""

$packages = @(
    "git",                  # Git for Windows
    "vscode",              # Visual Studio Code
    "zed",                 # Zed editor
    "alacritty"            # Terminal emulator
)

{{- if .install_dev_tools }}
$packages += "mise"        # Runtime version manager
{{- end }}

foreach ($package in $packages) {
    Write-Host "  → Installing $package..." -ForegroundColor Gray
    choco install $package -y --no-progress --limit-output
    
    if ($LASTEXITCODE -eq 0) {
        Write-Host "    ✅ $package installed" -ForegroundColor Green
    } else {
        Write-Host "    ⚠️  $package may have had issues (exit code: $LASTEXITCODE)" -ForegroundColor Yellow
    }
}

Write-Host ""

# ============================================
# INSTALLER ZOXIDE
# ============================================

if (!(Get-Command zoxide -ErrorAction SilentlyContinue)) {
    Write-Host "📦 Installing zoxide..." -ForegroundColor Cyan
    
    # Try winget first (Windows 11+)
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        winget install ajeetdsouza.zoxide --silent
    } 
    # Fallback to cargo if available
    elseif (Get-Command cargo -ErrorAction SilentlyContinue) {
        cargo install zoxide
    }
    else {
        Write-Host "⚠️  Could not install zoxide (no winget or cargo found)" -ForegroundColor Yellow
        Write-Host "   Install manually from: https://github.com/ajeetdsouza/zoxide" -ForegroundColor Yellow
    }
} else {
    Write-Host "✅ zoxide already installed" -ForegroundColor Green
}

Write-Host ""

# ============================================
# CONFIGURATION GIT
# ============================================

Write-Host "🔧 Configuring Git..." -ForegroundColor Cyan

# Set global config for Windows line endings
git config --global core.autocrlf true

Write-Host "✅ Git configured for Windows" -ForegroundColor Green
Write-Host ""

# ============================================
# RÉSUMÉ
# ============================================

Write-Host "════════════════════════════════════════" -ForegroundColor Cyan
Write-Host "✅ Windows setup complete!" -ForegroundColor Green
Write-Host "════════════════════════════════════════" -ForegroundColor Cyan
Write-Host ""
Write-Host "📋 Installed tools:" -ForegroundColor White
Write-Host "  • Chocolatey (package manager)" -ForegroundColor Gray
Write-Host "  • Git for Windows" -ForegroundColor Gray
Write-Host "  • Visual Studio Code" -ForegroundColor Gray
Write-Host "  • Zed editor" -ForegroundColor Gray
Write-Host "  • Alacritty terminal" -ForegroundColor Gray
{{- if .install_dev_tools }}
Write-Host "  • mise (runtime manager)" -ForegroundColor Gray
{{- end }}
Write-Host "  • zoxide (smart cd)" -ForegroundColor Gray
Write-Host ""
Write-Host "⚠️  Please restart your terminal to apply changes" -ForegroundColor Yellow
Write-Host ""

{{- end }}
